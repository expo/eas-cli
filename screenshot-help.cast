[1.4955780419986695, "o", "\u001b[32m✔\u001b[39m Connected to simulator session 01a14bca-29dd-7066-ae33-26dedf2aa312\r\n"]
[1.4956142499577254, "o", "\r\n"]
[1.4957594589795917, "o", "  \u001b[1mscreenshot.capture\u001b[22m\r\n"]
[1.4958145420532674, "o", "  Take a screenshot.\r\n\r\n  \u001b[1mUSAGE\u001b[22m\r\n"]
[1.496334542054683, "o", "    eas simulator:control screenshot.capture [fileName]\r\n"]
[1.497318624984473, "o", "      [--output <path>] [--id <session-id>] [--json]\r\n\r\n  \u001b[1mOPTIONS\u001b[22m\r\n    --id <session-id>  Defaults to .env.eas-simulator.\r\n    --json             Print the action schema as JSON. Implies --non-interactive.\r\n    --output <path>    Local filename or existing directory.\r\n                       Omit to save with the generated filename.\r\n\r\n  Action arguments refer to the simulator host. Use --output for the local filename.\r\n"]
[1.497340542031452, "o", "\r\n"]
[1.6085920839104801, "o", "\u001b[?25h"]
