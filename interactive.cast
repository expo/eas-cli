[1.2677512080408633, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[2K\u001b[1G\u001b[36m?\u001b[39m \u001b[1mChoose a simulator action\u001b[22m \u001b[90m›\u001b[39m \r\n\u001b[36m❯\u001b[39m   \u001b[36m\u001b[4mExit\u001b[39m\u001b[24m\u001b[90m\u001b[39m\r\n    clipboard.read\u001b[90m - Read simulator clipboard text.\u001b[39m\r\n    clipboard.write\u001b[90m - Write simulator clipboard text without pasting.\u001b[39m\r\n    clipboard.copy\u001b[90m - Copy the current selection and read its text.\u001b[39m\r\n    clipboard.paste\u001b[90m\r\n    Paste text into the focused field, or paste the current simulator clipboard if omitted.\u001b[39m\r\n    appearance.get\u001b[90m - Read light or dark mode.\u001b[39m\r\n    appearance.set\u001b[90m - Set light or dark mode.\u001b[39m\r\n    hardwareKeyboard.get\u001b[90m - Read whether the hardware keyboard is connected.\u001b[39m\r\n    hardwareKeyboard.set\u001b[90m - Connect or disconnect the hardware keyboard.\u001b[39m\r\n  ↓ reduceMotion.get\u001b[90m - Read Reduce Motion.\u001b[39m"]
[1.2873269580304623, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[2K\u001b[1G\u001b[36m?\u001b[39m \u001b[1mChoose a simulator action\u001b[22m \u001b[90m…\u001b[39m h\r\n\u001b[36m❯\u001b[39m   \u001b[36m\u001b[4mExit\u001b[39m\u001b[24m\u001b[90m\u001b[39m\r\n    clipboard.read\u001b[90m - Read simulator clipboard text.\u001b[39m\r\n    clipboard.write\u001b[90m - Write simulator clipboard text without pasting.\u001b[39m\r\n    clipboard.copy\u001b[90m - Copy the current selection and read its text.\u001b[39m\r\n    clipboard.paste\u001b[90m\r\n    Paste text into the focused field, or paste the current simulator clipboard if omitted.\u001b[39m\r\n    appearance.get\u001b[90m - Read light or dark mode.\u001b[39m\r\n    appearance.set\u001b[90m - Set light or dark mode.\u001b[39m\r\n    hardwareKeyboard.get\u001b[90m - Read whether the hardware keyboard is connected.\u001b[39m\r\n    hardwareKeyboard.set\u001b[90m - Connect or disconnect the hardware keyboard.\u001b[39m\r\n  ↓ reduceMotion.get\u001b[90m - Read Reduce Motion.\u001b[39m\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[2K\u001b[1G\u001b[36m?\u001b[39m \u001b[1mChoo"]
