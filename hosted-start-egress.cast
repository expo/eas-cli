[2.183026749873534, "o", "\u001b[33mUsing EAS CLI without version control system is not recommended, use this mode only if you know what you are doing.\u001b[39m\r\n"]
[2.3336660410277545, "o", "\u001b[33m  Overwriting previous simulator session (id: 01a1490e-f649-7f00-a6a0-8045d08105da). The previous remote session will continue running until stopped. To stop it, run: eas simulator:stop --id 01a1490e-f649-7f00-a6a0-8045d08105da\u001b[39m\r\n"]
