[7.400241167051718, "o", "\u001b[32m✔\u001b[39m Ran 7 actions on simulator session local-qa\r\n1. hardwareKeyboard.set: done\r\n2. hardwareKeyboard.get: off\r\n3. clipboard.write: {\"ok\":true}\r\n4. clipboard.read: {\"text\":\"EAS CLI ordered config import\"}\r\n5. media.add: done\r\n6. screenshot.capture: saved /private/tmp/eas-control-evidence-20261016/imported-screen.png\r\n7. hardwareKeyboard.set: done\r\n"]
[7.401531666982919, "o", "\u001b[?25l\u001b[2K\u001b[1G\u001b[36m?\u001b[39m \u001b[1mChoose a simulator action\u001b[22m \u001b[90m…\u001b[39m \r\n\u001b[90mno matches found\u001b[39m\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[2K\u001b[1G\u001b[36m?\u001b[39m \u001b[1mChoose a simulator action\u001b[22m \u001b[90m›\u001b[39m \r\n\u001b[36m❯\u001b[39m   \u001b[36m\u001b[4mExit\u001b[39m\u001b[24m\u001b[90m\u001b[39m\r\n    Import configuration\u001b[90m - Run actions from a version 1 JSON file.\u001b[39m\r\n    clipboard.read\u001b[90m - Read simulator clipboard text.\u001b[39m\r\n    clipboard.write\u001b[90m - Write simulator clipboard text without pasting.\u001b[39m\r\n    clipboard.copy\u001b[90m - Copy the current selection and read its text.\u001b[39m\r\n    clipboard.paste\u001b[90m\r\n    Paste text into the focused field, or paste the current simulator clipboard if omitted.\u001b[39m\r\n    appearance.get\u001b[90m - Read light or dark mode.\u001b[39m\r\n    appearance.set\u001b[90m - Set light or dark mode.\u001b[39m\r\n    hardwareKeyboard.get\u001b[90m - Read whether the hardware keyboard is connected.\u001b[39m\r\n  ↓ hardwareKeyboard.set\u001b[90m - Connect or disconnect the hardware keyboard.\u001b[39m"]
